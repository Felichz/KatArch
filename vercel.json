{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:slug(terreno|podio|principios|estilo|dominio|concurrencia)",
      "destination": "/es/:slug/",
      "permanent": true
    },
    {
      "source": "/:slug(terreno|podio|principios|estilo|dominio|concurrencia)/",
      "destination": "/es/:slug/",
      "permanent": true
    }
  ]
}
