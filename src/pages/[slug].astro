---
/**
 * One page per lesson of the earlier video course, plus redirects to the home from the old per-kata
 * courses (/archcolider/, /five-nines/) and from ArchColider's chapter URLs of when it was the only
 * course (/terreno/).
 */
import VideoChapterPage from '../components/video/VideoChapterPage.astro';
import { absolute } from '../i18n/paths';
import { UI } from '../i18n/ui';
import { COURSE, OLD_COURSES } from '../video/meta';

export function getStaticPaths() {
  return [
    ...COURSE.chapters.map((ch) => ({ params: { slug: ch.id }, props: { id: ch.id, redirect: null } })),
    ...Object.keys(OLD_COURSES).map((slug) => ({ params: { slug }, props: { id: slug, redirect: '/' } })),
    ...OLD_COURSES.archcolider.map((id) => ({ params: { slug: id }, props: { id, redirect: '/' } })),
  ];
}
const { id, redirect } = Astro.props;
---
{redirect ? (
  <html lang="es">
    <head>
      <meta charset="utf-8" />
      <title>KatArch</title>
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={absolute(redirect)} />
      <script is:inline define:vars={{ to: redirect }}>location.replace(to + location.hash);</script>
      <meta http-equiv="refresh" content={`0; url=${redirect}`} />
    </head>
    <body>
      <p>{UI.es.redirect.moved} <a href={redirect}>{redirect}</a></p>
    </body>
  </html>
) : (
  <VideoChapterPage id={id} />
)}
