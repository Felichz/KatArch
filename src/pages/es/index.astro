---
import HubPage from '../../components/HubPage.astro';
import { EDITION, TEXT_SITE_URL } from '../../lib/edition';
// the video course is Spanish at the root; /es/ belongs to the written course
const to = `${TEXT_SITE_URL}/es/`;
---
{EDITION === 'texto' ? (
  <HubPage locale="es" />
) : (
  <html lang="es">
    <head>
      <meta charset="utf-8" />
      <title>KatArch</title>
      <meta name="robots" content="noindex" />
      <meta http-equiv="refresh" content={`0; url=${to}`} />
      <link rel="canonical" href={to} />
    </head>
    <body><p>El curso escrito está en <a href={to}>{to}</a></p></body>
  </html>
)}
