---
import { ThemeToggle } from '../ThemeToggle';
import { IdiomaToggle } from '../IdiomaToggle';
import Dos from './Dos.astro';

type Texto = string | { es: string; en: string };

interface Props {
  /** the course the page belongs to: shown after the brand, linking to the course's page */
  course?: { title: Texto; href: string };
  /** a short location after the course, e.g. "Lección 4 de 11" */
  crumb?: Texto;
  /** the bilingual course: shows the ES / EN switch next to the theme toggle */
  bilingue?: boolean;
  /** the written edition of this page, when the course has one */
  textHref?: string;
}
const { course, crumb, textHref, bilingue = false } = Astro.props;
---
<header class="vtop">
  <a class="vbrand" href="/" aria-label="KatArch, inicio del curso">
    <span class="vbrand__mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"><path d="M4 20V4h4v6l6-6h5l-7.5 7.5L20 20h-5l-5.5-6L8 16v4z" fill="currentColor" /></svg></span>
    <span class="vbrand__name">KatArch</span>
  </a>
  {(course || crumb) && (
    <nav class="vtop__crumb" aria-label="Ubicación">
      {course && <a href={course.href}>{typeof course.title === 'string' ? course.title : <Dos {...course.title} />}</a>}
      {crumb && <span>{typeof crumb === 'string' ? crumb : <Dos {...crumb} />}</span>}
    </nav>
  )}
  <nav class="vtop__nav" aria-label="Enlaces">
    {textHref && (
      <a class="vtop__link" href={textHref}>
        Curso escrito
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    )}
    {bilingue && <IdiomaToggle client:load />}
    <ThemeToggle client:load locale="es" />
  </nav>
</header>
