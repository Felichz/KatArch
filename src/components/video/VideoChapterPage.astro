---
import VideoBase from './VideoBase.astro';
import VideoTopbar from './VideoTopbar.astro';
import { Watch } from './Watch';
import { COURSE, videoUrl, chapterPath, coursePath, progressKey } from '../../video/meta';

interface Props { id: string }
const CH = COURSE.chapters;
const i = CH.findIndex((c) => c.id === Astro.props.id);
const chapter = CH[i];
const prev = CH[i - 1] ?? null;
const next = CH[i + 1] ?? null;
const lite = (c: typeof chapter | null) => (c ? { id: c.id, number: c.number, title: c.title, poster: c.poster, duration: c.duration, href: chapterPath(c.id) } : null);
---
<VideoBase
  title={`${chapter.title} · Lección ${chapter.number} · KatArch`}
  description={chapter.blurb}
  path={chapterPath(chapter.id)}
  image={chapter.poster}
>
  <VideoTopbar crumb={`Lección ${chapter.number} de ${CH.length}`} />
  <Watch
    client:load
    chapter={{
      id: chapter.id,
      number: chapter.number,
      title: chapter.title,
      blurb: chapter.blurb,
      phase: chapter.phase,
      duration: chapter.duration,
      poster: chapter.poster,
      src: videoUrl(chapter),
      sections: chapter.sections,
      transcript: chapter.transcript,
      captions: chapter.captions,
      ideas: chapter.ideas,
    }}
    course={{ title: COURSE.title, href: coursePath() }}
    progressKey={progressKey(chapter.id)}
    total={CH.length}
    prev={lite(prev)}
    next={lite(next)}
  />
</VideoBase>
