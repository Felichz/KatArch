// KatArch on Cloudflare Workers (static assets). Production: katarch.medanolabs.com
// Deploy from this machine: `npm run deploy` (or `npm run deploy:staging`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "katarch",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "katarch.medanolabs.com", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "katarch-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "katarch-stg.medanolabs.com", "custom_domain": true }]
    }
  }
}
