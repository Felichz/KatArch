---
/**
 * Showreel for the portfolio case study: 1920×1080, rendered frame by frame by
 * scripts/render-reel.mjs. Not linked from the course and not indexed.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/player.css';
import '../styles/diagram.css';
import '../styles/scenes.css';
import '../styles/scenes2.css';
import '../styles/ch7.css';
import '../styles/ch8.css';
import '../styles/ch9.css';
import '../styles/ch10.css';
import '../styles/ch11.css';
import '../styles/reel.css';
import Reel from '../components/Reel';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1920, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>KatArch · showreel</title>
  </head>
  <body class="reel-body">
    <Reel client:only="react" />
  </body>
</html>
